              "function": "Protein repair active"
            },
            {
              "inci_name": "Bis(C13-15 Alkoxy) PG Amodimethicone",
              "percentage": 0.6,
              "function": "Amino-modified silicone for damaged hair adhesion"
            },
            {
              "inci_name": "50% Citric Acid",
              "percentage": 0.3,
              "function": "pH regulator"
            }
          ]
