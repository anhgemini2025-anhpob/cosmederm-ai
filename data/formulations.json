    {
      "formula_id": "FORM-HAIR-001",
      "title": "Damage Care & Moisturizing Shampoo (Dầu gội Phục hồi tóc hư tổn)",
      "target_category": "Haircare (Dầu gội phục hồi)",
      "sensory_feel_description": "Tạo bọt kem cực mịn, dính bám tốt vào vùng tóc hư tổn tích điện âm, giúp xả sạch mà tóc vẫn mềm mượt.",
      "phases": [
