    {
      "formula_id": "FORM-SKIN-001",
      "title": "Emollient Skin Cream (O/W Emulsion, Soap & Nonionic Base)",
      "target_category": "Skincare (Kem dưỡng ẩm mềm da)",
      "sensory_feel_description": "Kem có kết cấu mượt mà, độ giữ ẩm cao, dàn trải dễ dàng trên da mà không gây bết dính.",
      "phases": [
        {
          "phase_name": "Phase A (Oil Phase)",
          "ingredients": [
            {
              "inci_name": "Cetyl Alcohol",
              "percentage": 5.0,
              "function": "Thickener & Stiffening agent"
            },
            {
              "inci_name": "Stearic Acid",
              "percentage": 3.0,
              "function": "In-situ soap builder & Emollient"
            },
            {
              "inci_name": "Petrolatum",
              "percentage": 5.0,
              "function": "Occlusive moisture barrier"
            },
            {
              "inci_name": "Squalane",
              "percentage": 10.0,
              "function": "Emollient oil with high skin affinity"
            },
            {
              "inci_name": "Glycerol Tri-2-ethylhexanoate",
              "percentage": 7.0,
              "function": "Light ester oil for feel adjustment"
            },
            {
              "inci_name": "Propylene Glycol Monostearate",
              "percentage": 3.0,
              "function": "Lipophilic co-emulsifier"
            },
            {
              "inci_name": "POE (20) Cetyl Ether",
              "percentage": 3.0,
              "function": "Hydrophilic nonionic emulsifier"
            }
          ]
        },
        {
          "phase_name": "Phase B (Water Phase)",
          "ingredients": [
            {
              "inci_name": "Dipropylene Glycol",
              "percentage": 5.0,
              "function": "Humectant & Texture modifier"
            },
            {
              "inci_name": "Glycerin",
              "percentage": 5.0,
              "function": "Core humectant"
            },
            {
              "inci_name": "Triethanolamine (TEA)",
              "percentage": 1.0,
              "function": "Alkali neutralizer for Stearic acid"
            },
            {
              "inci_name": "Purified Water",
              "percentage": 58.0,
              "function": "Solvent / Bulk vehicle"
            }
          ]
        },
        {
          "phase_name": "Phase C (Additives)",
          "ingredients": [
            {
              "inci_name": "Preservative & Fragrance",
              "percentage": "q.s.",
              "function": "Preservation & Aesthetics"
            }
          ]
        }
      ],
      "specifications": {
        "ph_range": "6.5 - 7.5",
        "viscosity_cps": "25,000 - 35,000",
        "appearance": "White shiny cream"
      },
      "manufacturing_instructions": [
        "1. Trộn và đun nóng các thành phần Phase A đến 70-75°C cho tan chảy hoàn toàn.",
        "2. Hòa tan các chất Phase B trong nước tinh khiết và đun nóng đến 70-75°C.",
        "3. Cho Phase A từ từ vào Phase B trong khi khuấy đều để thực hiện phản ứng xà phòng hóa in-situ và nhũ hóa sơ bộ.",
        "4. Dùng Homomixer đồng hóa ở tốc độ 3000 rpm trong 5 phút để phân tán hạt nhũ mịn và đồng đều.",
        "5. Làm nguội từ từ dưới sự khuấy nhẹ xuống 45°C, cho Phase C vào, khử bọt và đóng gói ở 30°C."
      ],
      "formulation_know_how": "Phản ứng giữa Stearic acid và TEA tạo ra xà phòng triethanolamine stearate giúp hệ nhũ O/W đạt độ ổn định nhiệt độ cao và độ bóng đặc trưng chuẩn Nhật Bản.",
      "book_sources": [
        "Formulas, Ingredients and Production of Cosmetics (Iwata & Shimada)",
        "New Cosmetic Science (Takeo Mitsui)"
      ]
    },
    {
      "formula_id": "FORM-SKIN-002",
