        "viscosity_cps": "40,000 - 50,000",
        "appearance": "Glossy water-in-oil cream"
      },
      "manufacturing_instructions": [
        "1. Đun nóng Phase 1 đến 50°C, khuấy đều để tạo ra hợp chất nhũ tương surfactant phase (Amino Acid Gel).",
        "2. Đun tan chảy Phase 2 ở 70°C, sau đó phân tán đều phức hợp Amino Acid Gel từ Bước 1 vào Phase 2.",
        "3. Đun Phase 3 lên 70°C và cho từ từ vào hỗn hợp dầu, khuấy trộn mạnh với Homomixer.",
        "4. Khử bọt, lọc và làm nguội xuống 30°C."
      ],
      "formulation_know_how": "Kỹ thuật nhũ hóa gel axit amin giúp hệ W/O vốn bị coi là nhờn rít trở nên mượt mà, chứa được lượng nước lớn mà không bị tách pha ở nhiệt độ cao.",
      "book_sources": [
        "New Cosmetic Science (Takeo Mitsui)"
      ]
